<robot name="probe">
  <link name="world" />
  <link name="base">
    <collision><origin xyz="0 0 0.01" rpy="0 0 0.5" /><geometry><box size="0.1 0.2 0.3" /></geometry></collision>
    <inertial>
      <mass value="2.5" />
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1" />
    </inertial>
    <gazebo><plugin name="odd">{ "braces": "inside a string" }</plugin></gazebo>
  </link>
  <link name="upper-arm">
    <visual><geometry><mesh filename="/tmp/tmpt7tpaug1/meshes/arm.stl" /></geometry><material name="g"><color rgba="0.5 0.6 0.7 1" /></material></visual>
    <collision><geometry><cylinder radius="0.05" length="0.4" /></geometry></collision>
  </link>
  <link name="tool"><collision><geometry><sphere radius="0.03" /></geometry></collision></link>
  <joint name="floating_base" type="floating"><parent link="world" /><child link="base" /><origin xyz="0 0 0.8" /></joint>
  <joint name="shoulder" type="revolute"><parent link="base" /><child link="upper-arm" />
    <origin xyz="0.01 0.02 0.03" rpy="0.1 0.2 0.3" /><axis xyz="0.57735 0.57735 0.57735" />
    <limit lower="-1.2" upper="0.8" effort="5" velocity="1" /></joint>
  <joint name="wrist" type="continuous"><parent link="upper-arm" /><child link="tool" />
    <origin xyz="0 0 0.4" /><axis xyz="0 1 0" /></joint>
</robot>